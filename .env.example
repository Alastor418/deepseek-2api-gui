# Скопируй в .env и раскомментируй нужное.
# Все значения по умолчанию — безопасны для локальной машины.

GUI_HOST=127.0.0.1
GUI_PORT=8080

# Если не задан — генерируется автоматически и сохраняется в
# ~/.deepseek-2api/api_key.txt (chmod 600).
# API_MASTER_KEY=sk-mycustomkey

# Автологин headless при истечении токена
AUTO_RELOGIN=true
MAX_RETRIES=2
AUTO_RELOGIN_TIMEOUT=180

# Автоматически включать веб-поиск у Deepseek, если клиент (например,
# Harness) прислал tools с именем web_search. Отключи, если хочешь,
# чтобы модель отвечала только из своего знания.
AUTO_WEB_SEARCH=false

# Форсировать reasoning / поиск для всех запросов (медленнее)
FORCE_THINKING=false
FORCE_SEARCH=false

# Таймауты
REQUEST_TIMEOUT=300
POW_TIMEOUT=60

# Логи
LOG_TO_FILE=true
LOG_ROTATION_MB=10
LOG_RETENTION=5
